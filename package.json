{
  "name": "react-native-adpopcorn-reward",
  "version": "2.0.0",
  "description": "AdPopcorn Reward (Offerwall) SDK React Native Plugin - TurboModule Version",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "react-native.config.js",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-adpopcorn-reward-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "adpopcorn",
    "reward",
    "offerwall",
    "native-ad",
    "advertising",
    "ios",
    "android"
  ],
  "author": "Dongmin, Yu <ydm2790@gmail.com> (https://github.com/AndrewDongminYoo)",
  "license": "MIT",
  "homepage": "https://github.com/AndrewDongminYoo/react-native-adpopcorn-reward#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewDongminYoo/react-native-adpopcorn-reward.git"
  },
  "bugs": {
    "url": "https://github.com/AndrewDongminYoo/react-native-adpopcorn-reward/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^30.0.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "espree": "^11.2.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "react": "19.2.8",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.41.0",
    "turbo": "^2.9.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "resolutions": {
    "jest-environment-node": "^30.4.1",
    "joi": "^17.13.4",
    "launch-editor": "^2.14.1",
    "qs": "^6.16.0",
    "undici": "^6.27.0"
  },
  "packageManager": "yarn@4.11.0",
  "codegenConfig": {
    "name": "AdpopcornRewardSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.adpopcorn.adpopcornreward.reactnative"
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.62.0"
  }
}
